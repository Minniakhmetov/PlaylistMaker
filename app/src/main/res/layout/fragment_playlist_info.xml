<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlist_info_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_light_gray"
    tools:context=".playlistInfo.ui.PlaylistInfoFragment">



    <LinearLayout
        android:id="@+id/ll_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                android:id="@+id/playlist_img"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/ic_track_placeholder_312"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/playlist_info_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentInsetStartWithNavigation="64dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:navigationIcon="@drawable/ic_arrow_back_24"
                app:navigationIconTint="?attr/colorOnPrimary"
                app:titleTextAppearance="@style/MainTitleStyle"
                tools:ignore="MissingConstraints" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_playlist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:textColor="@color/yp_black"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/playlist_img"
                tools:text="Best songs 2021" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_playlist_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/yp_black"
                android:textSize="18sp"
                android:fontFamily="@font/ys_display_regular"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_playlist_name"
                tools:text="2022" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_playlist_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/yp_black"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_playlist_description"
                tools:text="300 минут" />

            <ImageView
                android:id="@+id/ic_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:src="@drawable/ic_track_separator_3"
                app:tint="@color/yp_black"
                app:layout_constraintBottom_toBottomOf="@+id/tv_playlist_duration"
                app:layout_constraintStart_toEndOf="@+id/tv_playlist_duration"
                app:layout_constraintTop_toTopOf="@+id/tv_playlist_duration" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_tracks_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/yp_black"
                android:textSize="18sp"
                app:layout_constraintStart_toEndOf="@+id/ic_point"
                app:layout_constraintTop_toTopOf="@+id/tv_playlist_duration"
                tools:text="98 треков" />

            <ImageView
                android:id="@+id/img_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_share_the_app_24"
                app:tint="@color/yp_black"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@+id/tv_playlist_duration"
                app:layout_constraintTop_toBottomOf="@+id/tv_playlist_duration" />

            <ImageView
                android:id="@+id/img_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_more_24"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/img_share"
                app:layout_constraintTop_toBottomOf="@+id/tv_playlist_duration"
                app:tint="@color/yp_black" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlist_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="160dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <TextView
            android:id="@+id/tv_tracks_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="В этом плейлисте нет треков"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/yp_black"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlayerPlaylists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottom_sheet_behavior_menu"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        app:behavior_hideable="true"
        android:visibility="visible"
        app:behavior_peekHeight="360dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:backgroundTint="@android:color/transparent"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/img_menu_playlist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_track_placeholder_45" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/cardView"
                app:layout_constraintStart_toEndOf="@+id/cardView"
                app:layout_constraintTop_toTopOf="@+id/cardView">

                <TextView
                    android:id="@+id/tv_menu_playlist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="16sp"
                    tools:text="Название" />

                <TextView
                    android:id="@+id/tv_menu_playlist_count"
                    style="@style/SearchItemTrack"
                    tools:text="5 треков" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_btn_menu_share_playlist"
            style="@style/SettingButtonStyle"
            android:text="Поделиться" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_btn_menu_edit_playlist"
            style="@style/SettingButtonStyle"
            android:text="Редактировать информацию" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_btn_menu_delete_playlist"
            style="@style/SettingButtonStyle"
            android:text="Удалить плейлист" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
